
loadimport "../script/std.soare";

@Fib(n)

    @Check(x)
        if x < 1 do
            return "Invalid Input"
        orif x == 1 do
            return 0;
        orif x == 2 do
            return 1;
        end;
        return M(0-1);
    end;

    value = Check(n);

    if value == M(0-1) do
        return Fib(n-1) + Fib(n-2);
    end;

    return value;

end;

write Fib(10); ? 34
