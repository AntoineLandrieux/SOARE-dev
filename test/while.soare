
loadimport "../script/std.soare";

@sleep(time)
    if NaN!(time) do
        return 0;
    end;
    if time < 0 do
        time = time * M!(0-1);
    end;
    time = time * 999999;
    while time do
        time = time - 1;
    end;
end;

times = 0;

while times < 10 + 1 do
    
    __WRITE_END__ = "";
    write "[" + times + "/" + 10 + "]" + TAB;

    progressbar = 0;
    while progressbar < times + 1 do
        write "=";
        progressbar = progressbar + 1;
    end;

    sleep!(1);
    times = times + 1;

    __WRITE_END__ = CR;
    write "";

end;

__WRITE_END__ = LN;
write "===== SUCESS =====";
inputch __WRITE_END__;
