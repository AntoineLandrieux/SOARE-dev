
@String gh_link(String FirstName; String LastName)
    return "https://github.com/" + FirstName + LastName + "/";
end;

? Main function
? Take 2 arguments (name and age)
@None card(String FirstName; String LastName; Number age)

    writeln "==========================================";
    writeln "Hello " + FirstName;
    writeln "";
    writeln "ID: " + FirstName + " " + LastName;
    writeln "YO: " + age;
    writeln "GH: " + gh_link!(FirstName; LastName);
    writeln "==========================================";

end;

card!("Antoine"; "Landrieux"; 16);
