
loadimport "../script/std.soare"

pi = 3.1415

writeln 1+3.1   ?  4.100
writeln 1-3     ? -2.000
writeln 2.5*3   ?  7.500
writeln "7"/"4" ?  1.750
writeln 4%3     ?  1
writeln 1^3     ?  2
writeln 1<3     ?  1
writeln 1>3     ?  0

try
    writeln 4/0;
iferror
    writeln "Can't devide by 0"
end;

writeln ftoi!(pi) ? 3
