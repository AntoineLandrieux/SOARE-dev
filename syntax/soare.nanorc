syntax "soare" "\.soare$"

## Comments
color green  "?.*$"

## Strings
color brightblue ""(\\.|[^"])*""
color brightblue ""(\\.|[^'])+'"
color brightblue ""(\\.|[^`])+`"

## Keywords
color blue "\<(and|break|do|else|elseif|end|false|for|function|goto|if|in|local|nil|not|or|repeat|return|then|true|until|while)\>"

## Numbers
color cyan "\<[0-9]+([eE][0-9]+)?"

## Functions
color magenta "\<[a-zA-Z_][a-zA-Z0-9_]*[ \t]*\("

## Operators
color yellow "[-+/*=<>%]"

## Metamethods
color red "__[a-zA-Z_][a-zA-Z0-9_]*"

## Background for brackets
color ,red "(\(|\)|

\[|\]

|\{|\})"

## Trailing whitespace
color ,red "[[:space:]]+$"
